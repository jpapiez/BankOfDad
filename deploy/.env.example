# Copy to deploy/.env on the server and fill in. Never commit .env.

# Database (the password is applied when the volume is first created)
POSTGRES_USER=bankofdad
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=bankofdad

# JWT signing key, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Tailscale: auth key from https://login.tailscale.com/admin/settings/keys.
# Only used for the first login; the node identity is kept in the tailscale-state volume.
TS_AUTHKEY=
# Node name -> https://bankofdad.<your-tailnet>.ts.net
TS_HOSTNAME=bankofdad
# Optional extra `tailscale up` flags, e.g. --advertise-tags=tag:bankofdad
TS_EXTRA_ARGS=

# API image (published by .github/workflows/publish-image.yml). Pin a sha-xxxxxxx tag to hold a version.
BANKOFDAD_IMAGE=ghcr.io/jpapiez/bankofdad-api:latest
# Loopback port on the server for health checks (curl http://127.0.0.1:8080/health)
API_LOCAL_PORT=8080

# Sign in with Apple. Put its .p8 private key in deploy/secrets/SignInWithAppleKey.p8.
APPLE_CLIENT_ID=com.example.bankofdad
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Generate once with: openssl rand -base64 32. Back it up securely and keep it stable.
APPLE_TOKEN_ENCRYPTION_KEY=

# APNs (optional). Put its .p8 private key in deploy/secrets/AuthKey.p8.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.bankofdad
APNS_USE_SANDBOX=true
