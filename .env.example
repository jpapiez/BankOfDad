# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=bankofdad
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bankofdad

# At least 32 characters
JWT_SIGNING_KEY=replace-with-a-long-random-secret-value-32+chars

# Sign in with Apple. The .p8 key must support Sign in with Apple.
APPLE_CLIENT_ID=com.example.bankofdad
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY_PATH=/run/secrets/apple/SignInWithAppleKey.p8
# Generate once with: openssl rand -base64 32
# Keep stable: changing it makes retained Apple refresh tokens undecryptable.
APPLE_TOKEN_ENCRYPTION_KEY=

# APNs (optional). When APNS_KEY_ID is empty the API logs pushes instead of sending them.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.bankofdad
APNS_USE_SANDBOX=true
# Path inside the container to the .p8 key (mount ./secrets to /run/secrets/apple)
APNS_KEY_PATH=/run/secrets/apple/AuthKey.p8

# NuGet feed used by the Docker build (override if api.nuget.org is blocked on your network)
NUGET_SOURCE=https://api.nuget.org/v3/index.json

# Development-only UI-test endpoints under /api/v1/testing (backdate installments, run the
# reminder/late-fee sweep). Only honored when ASPNETCORE_ENVIRONMENT=Development. Keep false;
# ios/scripts/run-ui-tests.sh turns it on for local UI test runs.
TEST_HOOKS_ENABLED=false
