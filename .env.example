# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=bankofdad
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bankofdad

# At least 32 characters
JWT_SIGNING_KEY=replace-with-a-long-random-secret-value-32+chars

# Sign in with Apple: your iOS app bundle id (audience of Apple identity tokens)
APPLE_CLIENT_ID=com.example.bankofdad

# APNs (optional). When APNS_KEY_ID is empty the API logs pushes instead of sending them.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.bankofdad
APNS_USE_SANDBOX=true
# Path inside the container to the .p8 key (mount ./secrets to /run/secrets/apns)
APNS_KEY_PATH=/run/secrets/apns/AuthKey.p8

# NuGet feed used by the Docker build (override if api.nuget.org is blocked on your network)
NUGET_SOURCE=https://api.nuget.org/v3/index.json
